rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profilePath() {
      return /databases/$(database)/documents/profiles/$(request.auth.uid);
    }

    function hasActiveProfile() {
      return signedIn()
        && exists(profilePath())
        && get(profilePath()).data.isActive == true;
    }

    function role() {
      return hasActiveProfile() ? get(profilePath()).data.role : 'none';
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function canEvaluate() {
      return role() == 'admin' || role() == 'evaluator';
    }

    function validRole(value) {
      return value == 'viewer' || value == 'evaluator' || value == 'admin';
    }

    function validYear(value) {
      return value is int && value >= 2500 && value <= 3000;
    }

    function validGregorianYear(value) {
      return value is int && value >= 2000 && value <= 2200;
    }

    function validMonthZeroBased(value) {
      return value is int && value >= 0 && value <= 11;
    }

    function validMonthOneBased(value) {
      return value is int && value >= 1 && value <= 12;
    }

    function validYearMonth(value) {
      return value is string
        && value.size() == 7
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])$');
    }

    function validIsoDate(value) {
      return value is string
        && value.size() == 10
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-[0-9]{2}$');
    }

    function validCreateMetadata(data) {
      return data.createdAt == request.time
        && data.createdBy == request.auth.uid
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function validUpdateMetadata(data) {
      return data.createdAt == resource.data.createdAt
        && data.createdBy == resource.data.createdBy
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function versionStartsAtOne(data) {
      return data.version is int && data.version == 1;
    }

    function versionIncrementsByOne(data) {
      return data.version is int && data.version == resource.data.version + 1;
    }

    function monthClosurePath(yearMonth) {
      return /databases/$(database)/documents/monthClosures/$(yearMonth);
    }

    function monthlyStatusPath(yearMonth) {
      return /databases/$(database)/documents/monthlyPerformanceStatus/$(yearMonth);
    }

    function monthIsEditable(yearMonth) {
      return validYearMonth(yearMonth)
        && (!exists(monthClosurePath(yearMonth))
          || get(monthClosurePath(yearMonth)).data.status != 'FINALIZED');
    }

    function monthlyEntryIsEditable(yearMonth) {
      return monthIsEditable(yearMonth)
        && (!exists(monthlyStatusPath(yearMonth))
          || get(monthlyStatusPath(yearMonth)).data.status != 'CLOSED');
    }

    function validScore(value) {
      return value is int && value >= 20 && value <= 100 && value % 5 == 0;
    }

    function validScores(scores) {
      return scores is list
        && scores.size() == 6
        && validScore(scores[0])
        && validScore(scores[1])
        && validScore(scores[2])
        && validScore(scores[3])
        && validScore(scores[4])
        && validScore(scores[5]);
    }

    function validProfile(data) {
      return data.keys().hasOnly(['displayName', 'role', 'isActive'])
        && data.displayName is string
        && data.displayName.size() <= 100
        && validRole(data.role)
        && data.isActive is bool;
    }

    function validSettings(data) {
      return data.keys().hasOnly(['activeYear', 'years', 'updatedAt', 'updatedBy'])
        && validYear(data.activeYear)
        && data.years is list
        && data.years.size() >= 1
        && data.years.size() <= 100
        && data.activeYear in data.years
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function validEmployee(data) {
      return data.keys().hasOnly([
          'name', 'nameNormalized', 'fullName', 'employeeCode', 'startDate',
          'isActive', 'sortOrder', 'legacyIds', 'source', 'version',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'migratedAt'
        ])
        && data.name is string
        && data.name.size() >= 2
        && data.name.size() <= 100
        && data.nameNormalized is string
        && data.nameNormalized.size() >= 2
        && data.nameNormalized.size() <= 100
        && (!('fullName' in data) || (data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100))
        && (!('employeeCode' in data) || (data.employeeCode is string && data.employeeCode.size() <= 20))
        && (!('startDate' in data) || (data.startDate is string && data.startDate.size() <= 10))
        && (!('isActive' in data) || data.isActive is bool)
        && (!('sortOrder' in data) || (data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 100000))
        && (!('legacyIds' in data) || data.legacyIds is map)
        && (!('source' in data) || (data.source is string && data.source.size() <= 100))
        && (!('version' in data) || (data.version is int && data.version >= 1))
        && (!('migratedAt' in data) || data.migratedAt is timestamp)
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function validEvaluation(data) {
      return data.keys().hasOnly([
          'employeeId', 'yearMonth', 'year', 'month', 'scores', 'note', 'source',
          'sourceSync', 'scoreSources', 'syncStatus', 'disciplinePending',
          'manualOverrides', 'version', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ])
        && data.employeeId is string
        && data.employeeId.size() >= 2
        && data.employeeId.size() <= 80
        && validYearMonth(data.yearMonth)
        && validYear(data.year)
        && validMonthZeroBased(data.month)
        && validScores(data.scores)
        && data.note is string
        && data.note.size() <= 2000
        && data.source is string
        && data.source.size() <= 160
        && data.sourceSync is map
        && data.scoreSources is map
        && (data.syncStatus == 'manual'
          || data.syncStatus == 'synced'
          || data.syncStatus == 'source_changed'
          || data.syncStatus == 'manual_override')
        && data.disciplinePending is bool
        && data.manualOverrides is map
        && data.version is int
        && data.version >= 1
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function immutableEvaluationFields() {
      return request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.yearMonth == resource.data.yearMonth
        && request.resource.data.year == resource.data.year
        && request.resource.data.month == resource.data.month
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    function validMoney(value) {
      return value is number && value >= -100000000 && value <= 100000000;
    }

    function validServiceIncentive(data) {
      return data.keys().hasOnly([
          'employeeId', 'yearMonth', 'year', 'month', 'salesAmount',
          'evaluationAmount', 'timeAmount', 'totalAmount', 'source',
          'sourceRecordId', 'sourceCreatedAt', 'sourceUpdatedAt', 'version',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'importedAt'
        ])
        && data.employeeId is string
        && data.employeeId.size() >= 2
        && data.employeeId.size() <= 80
        && validYearMonth(data.yearMonth)
        && validGregorianYear(data.year)
        && validMonthOneBased(data.month)
        && validMoney(data.salesAmount)
        && validMoney(data.evaluationAmount)
        && validMoney(data.timeAmount)
        && validMoney(data.totalAmount)
        && data.totalAmount >= data.salesAmount + data.evaluationAmount + data.timeAmount - 0.01
        && data.totalAmount <= data.salesAmount + data.evaluationAmount + data.timeAmount + 0.01
        && data.source is string
        && data.source.size() <= 160
        && (!('sourceRecordId' in data) || (data.sourceRecordId is string && data.sourceRecordId.size() <= 160))
        && (!('sourceCreatedAt' in data) || data.sourceCreatedAt == null || data.sourceCreatedAt is timestamp)
        && (!('sourceUpdatedAt' in data) || data.sourceUpdatedAt == null || data.sourceUpdatedAt is timestamp)
        && (!('importedAt' in data) || data.importedAt is timestamp)
        && data.version is int
        && data.version >= 1
        && data.createdAt is timestamp
        && data.createdBy is string
        && data.updatedAt == request.time
        && data.updatedBy == request.auth.uid;
    }

    function immutableServiceFields() {
      return request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.yearMonth == resource.data.yearMonth
        && request.resource.data.year == resource.data.year
        && request.resource.data.month == resource.data.month
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
    }

    function validLateScore(value) {
      return value == 60 || value == 70 || value == 80 || value == 90 || value == 100;
    }

    function expectedLateScore(minutes) {
      return minutes <= 29 ? 100
        : minutes <= 59 ? 90
        : minutes <= 89 ? 80
        : minutes <= 119 ? 70
        : 60;
    }

    function validAttendance(data) {
      return data.keys().hasOnly([
          'employeeId', 'yearMonth', 'year', 'month', 'lateMinutes', 'lateScore',
          'source', 'sourceRecordId', 'sourceDate', 'version', 'createdAt',
          'createdBy', 'updatedAt', 'updatedBy', 'importedAt'
        ])
        && data.employeeId is string && data.employeeId.size() >= 2 && data.employeeId.size() <= 80
        && validYearMonth(data.yearMonth)
        && validGregorianYear(data.year)
        && validMonthOneBased(data.month)
        && data.lateMinutes is int && data.lateMinutes >= 0 && data.lateMinutes <= 100000
        && validLateScore(data.lateScore)
        && data.lateScore == expectedLateScore(data.lateMinutes)
        && data.source is string && data.source.size() <= 160
        && (!('sourceRecordId' in data) || (data.sourceRecordId is string && data.sourceRecordId.size() <= 160))
        && (!('sourceDate' in data) || (data.sourceDate is string && data.sourceDate.size() <= 40))
        && (!('importedAt' in data) || data.importedAt is timestamp)
        && data.createdAt is timestamp && data.createdBy is string
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }

    function validLeaveRecord(data) {
      return data.keys().hasOnly([
          'employeeId', 'date', 'yearMonth', 'year', 'month', 'leaveType', 'days',
          'note', 'excludeHolidays', 'source', 'sourceRecordId', 'originalLeaveType',
          'migrationAdjustment', 'version', 'createdAt', 'createdBy', 'updatedAt',
          'updatedBy', 'importedAt'
        ])
        && data.employeeId is string && data.employeeId.size() >= 2 && data.employeeId.size() <= 80
        && validIsoDate(data.date)
        && validYearMonth(data.yearMonth)
        && validGregorianYear(data.year)
        && validMonthOneBased(data.month)
        && (data.leaveType == 'sick' || data.leaveType == 'personal'
          || data.leaveType == 'vacation' || data.leaveType == 'ordination'
          || data.leaveType == 'other')
        && data.days is number && data.days > 0 && data.days <= 365
        && data.note is string && data.note.size() <= 1000
        && data.excludeHolidays is bool
        && data.source is string && data.source.size() <= 160
        && (!('sourceRecordId' in data) || (data.sourceRecordId is string && data.sourceRecordId.size() <= 160))
        && (!('originalLeaveType' in data) || (data.originalLeaveType is string && data.originalLeaveType.size() <= 80))
        && (!('migrationAdjustment' in data) || (data.migrationAdjustment is string && data.migrationAdjustment.size() <= 500))
        && (!('importedAt' in data) || data.importedAt is timestamp)
        && data.createdAt is timestamp && data.createdBy is string
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }

    function validMonthlyScore(value, legacyException) {
      return value is number && value >= -0.5
        && (value <= 3 || (legacyException && value == 3.5));
    }

    function validMonthlyScores(scores, status, legacyException) {
      return scores is map
        && scores.keys().hasOnly(['C1', 'C2', 'C3', 'C4', 'C5'])
        && ((status != 'WORK' && status != 'WEEKEND_WORK')
          || scores.keys().hasAll(['C1', 'C2', 'C3', 'C4', 'C5']))
        && (!('C1' in scores) || validMonthlyScore(scores.C1, legacyException))
        && (!('C2' in scores) || validMonthlyScore(scores.C2, legacyException))
        && (!('C3' in scores) || validMonthlyScore(scores.C3, legacyException))
        && (!('C4' in scores) || validMonthlyScore(scores.C4, legacyException))
        && (!('C5' in scores) || validMonthlyScore(scores.C5, legacyException));
    }

    function validDailyPerformance(data) {
      return data.keys().hasOnly([
          'employeeId', 'yearMonth', 'year', 'month', 'date', 'status',
          'countsAsWork', 'note', 'scores', 'legacyException', 'source',
          'sourceRecordId', 'sourceScoreRecordIds', 'sourceUpdatedAt', 'version',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'importedAt'
        ])
        && data.employeeId is string && data.employeeId.size() >= 2 && data.employeeId.size() <= 80
        && validYearMonth(data.yearMonth)
        && validGregorianYear(data.year)
        && validMonthOneBased(data.month)
        && validIsoDate(data.date)
        && (data.status == 'WORK' || data.status == 'WEEKEND_WORK'
          || data.status == 'SICK_LEAVE' || data.status == 'PERSONAL_LEAVE'
          || data.status == 'VACATION' || data.status == 'COMP_OFF'
          || data.status == 'HOLIDAY')
        && data.countsAsWork == (data.status == 'WORK' || data.status == 'WEEKEND_WORK')
        && data.note is string && data.note.size() <= 1000
        && data.legacyException is bool
        && validMonthlyScores(data.scores, data.status, data.legacyException)
        && data.source is string && data.source.size() <= 160
        && (!('sourceRecordId' in data) || (data.sourceRecordId is string && data.sourceRecordId.size() <= 160))
        && (!('sourceScoreRecordIds' in data) || data.sourceScoreRecordIds is list)
        && (!('sourceUpdatedAt' in data) || data.sourceUpdatedAt is timestamp)
        && (!('importedAt' in data) || data.importedAt is timestamp)
        && data.createdAt is timestamp && data.createdBy is string
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }

    function validMonthlyOverride(data) {
      return data.keys().hasOnly([
          'employeeId', 'yearMonth', 'year', 'month', 'actualWorkDaysOverride',
          'source', 'sourceUpdatedAt', 'sourceUpdatedBy', 'version', 'createdAt',
          'createdBy', 'updatedAt', 'updatedBy', 'importedAt'
        ])
        && data.employeeId is string && data.employeeId.size() >= 2 && data.employeeId.size() <= 80
        && validYearMonth(data.yearMonth)
        && validGregorianYear(data.year)
        && validMonthOneBased(data.month)
        && data.actualWorkDaysOverride is int
        && data.actualWorkDaysOverride >= 0 && data.actualWorkDaysOverride <= 31
        && data.source is string && data.source.size() <= 160
        && (!('sourceUpdatedAt' in data) || data.sourceUpdatedAt is timestamp)
        && (!('sourceUpdatedBy' in data) || data.sourceUpdatedBy is string)
        && (!('importedAt' in data) || data.importedAt is timestamp)
        && data.createdAt is timestamp && data.createdBy is string
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }

    function validMonthlyStatus(data) {
      return data.keys().hasOnly([
          'yearMonth', 'year', 'month', 'status', 'reason', 'validation', 'version',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'closedAt', 'closedBy'
        ])
        && validYearMonth(data.yearMonth)
        && validGregorianYear(data.year)
        && validMonthOneBased(data.month)
        && (data.status == 'OPEN' || data.status == 'REVIEW' || data.status == 'CLOSED')
        && data.reason is string && data.reason.size() <= 1000
        && (data.validation == null || data.validation is map)
        && (!('closedAt' in data) || data.closedAt is timestamp)
        && (!('closedBy' in data) || data.closedBy is string)
        && data.createdAt is timestamp && data.createdBy is string
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }

    function validWorkdaySettings(data) {
      return data.keys().hasOnly([
          'configured', 'sickAnnualDays', 'personalAnnualDays',
          'vacationAfter1Year', 'vacationAfter3Years', 'vacationAfter6Years',
          'vacationAfter9Years', 'vacationAfter12Years', 'vacationAfter15Years',
          'vacationReference', 'note', 'updatedAt', 'updatedBy'
        ])
        && data.configured is bool
        && data.sickAnnualDays is number && data.sickAnnualDays >= 0 && data.sickAnnualDays <= 365
        && data.personalAnnualDays is number && data.personalAnnualDays >= 0 && data.personalAnnualDays <= 365
        && data.vacationAfter1Year is number && data.vacationAfter3Years is number
        && data.vacationAfter6Years is number && data.vacationAfter9Years is number
        && data.vacationAfter12Years is number && data.vacationAfter15Years is number
        && data.vacationAfter1Year >= 0 && data.vacationAfter1Year <= 365
        && data.vacationAfter3Years >= data.vacationAfter1Year && data.vacationAfter3Years <= 365
        && data.vacationAfter6Years >= data.vacationAfter3Years && data.vacationAfter6Years <= 365
        && data.vacationAfter9Years >= data.vacationAfter6Years && data.vacationAfter9Years <= 365
        && data.vacationAfter12Years >= data.vacationAfter9Years && data.vacationAfter12Years <= 365
        && data.vacationAfter15Years >= data.vacationAfter12Years && data.vacationAfter15Years <= 365
        && (data.vacationReference == 'jan1' || data.vacationReference == 'yearEnd')
        && data.note is string && data.note.size() <= 1000
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }

    function validClosureSummary(summary) {
      return summary is map
        && summary.keys().hasOnly([
          'eligibleEmployeeCount', 'attendanceComplete', 'monthlyComplete',
          'scoreSyncComplete', 'disciplineComplete', 'gpaIncentiveComplete',
          'serviceIncentiveComplete', 'monthlyValidationErrors',
          'monthlyValidationWarnings', 'requiredDone', 'coreReady'
        ])
        && summary.eligibleEmployeeCount is int && summary.eligibleEmployeeCount >= 0
        && summary.attendanceComplete is int && summary.attendanceComplete >= 0
        && summary.monthlyComplete is int && summary.monthlyComplete >= 0
        && summary.scoreSyncComplete is int && summary.scoreSyncComplete >= 0
        && summary.disciplineComplete is int && summary.disciplineComplete >= 0
        && summary.gpaIncentiveComplete is int && summary.gpaIncentiveComplete >= 0
        && summary.serviceIncentiveComplete is int && summary.serviceIncentiveComplete >= 0
        && summary.monthlyValidationErrors is int && summary.monthlyValidationErrors >= 0
        && summary.monthlyValidationWarnings is int && summary.monthlyValidationWarnings >= 0
        && summary.requiredDone is int && summary.requiredDone >= 0
        && summary.coreReady is bool;
    }

    function validMonthClosure(data) {
      return data.keys().hasOnly([
          'yearMonth', 'year', 'month', 'status', 'reason', 'summary', 'version',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy', 'finalizedAt',
          'finalizedBy', 'reopenedAt', 'reopenedBy'
        ])
        && validYearMonth(data.yearMonth)
        && validGregorianYear(data.year)
        && validMonthOneBased(data.month)
        && (data.status == 'FINALIZED' || data.status == 'REOPENED')
        && data.reason is string && data.reason.size() <= 1000
        && validClosureSummary(data.summary)
        && data.finalizedAt is timestamp && data.finalizedBy is string
        && (!('reopenedAt' in data) || data.reopenedAt is timestamp)
        && (!('reopenedBy' in data) || data.reopenedBy is string)
        && data.createdAt is timestamp && data.createdBy is string
        && data.updatedAt == request.time && data.updatedBy == request.auth.uid;
    }

    function validAuditLog(data) {
      return data.keys().hasOnly([
          'actorId', 'action', 'targetType', 'targetId', 'before', 'after', 'createdAt'
        ])
        && data.actorId == request.auth.uid
        && data.action is string && data.action.size() >= 3 && data.action.size() <= 60
        && data.targetType is string && data.targetType.size() >= 2 && data.targetType.size() <= 40
        && data.targetId is string && data.targetId.size() <= 160
        && (data.before == null || data.before is map)
        && (data.after == null || data.after is map)
        && data.createdAt == request.time;
    }

    match /profiles/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update: if isAdmin() && validProfile(request.resource.data);
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    // Collection เดิมของ Performance Summary
    match /settings/{settingId} {
      allow read: if hasActiveProfile();
      allow create, update: if isAdmin() && settingId == 'main' && validSettings(request.resource.data);
      allow delete: if false;
    }

    // Employee Master กลาง และยังรองรับ Web Performance Summary เดิม
    match /employees/{employeeId} {
      allow read: if hasActiveProfile();
      allow create: if isAdmin()
        && validEmployee(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isAdmin()
        && validEmployee(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }

    match /employeeNames/{nameHash} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['employeeId', 'normalizedName', 'createdAt'])
        && request.resource.data.employeeId is string
        && request.resource.data.normalizedName is string
        && request.resource.data.createdAt == request.time;
      allow delete: if isAdmin();
    }

    match /evaluations/{evaluationId} {
      allow read: if hasActiveProfile();
      allow create: if canEvaluate()
        && validEvaluation(request.resource.data)
        && versionStartsAtOne(request.resource.data)
        && validCreateMetadata(request.resource.data)
        && monthIsEditable(request.resource.data.yearMonth);
      allow update: if canEvaluate()
        && validEvaluation(request.resource.data)
        && immutableEvaluationFields()
        && versionIncrementsByOne(request.resource.data)
        && validUpdateMetadata(request.resource.data)
        && monthIsEditable(request.resource.data.yearMonth);
      allow delete: if isAdmin() && monthIsEditable(resource.data.yearMonth);
    }

    // โมดูลใหม่ Phase 1
    match /serviceIncentives/{incentiveId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && validServiceIncentive(request.resource.data)
        && versionStartsAtOne(request.resource.data)
        && validCreateMetadata(request.resource.data)
        && monthIsEditable(request.resource.data.yearMonth);
      allow update: if isAdmin()
        && validServiceIncentive(request.resource.data)
        && immutableServiceFields()
        && versionIncrementsByOne(request.resource.data)
        && validUpdateMetadata(request.resource.data)
        && monthIsEditable(request.resource.data.yearMonth);
      allow delete: if isAdmin() && monthIsEditable(resource.data.yearMonth);
    }

    match /hubSettings/{settingId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
      allow delete: if false;
    }

    match /attendanceMonthly/{documentId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && validAttendance(request.resource.data)
        && versionStartsAtOne(request.resource.data)
        && validCreateMetadata(request.resource.data)
        && monthIsEditable(request.resource.data.yearMonth);
      allow update: if isAdmin()
        && validAttendance(request.resource.data)
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.yearMonth == resource.data.yearMonth
        && versionIncrementsByOne(request.resource.data)
        && validUpdateMetadata(request.resource.data)
        && monthIsEditable(request.resource.data.yearMonth);
      allow delete: if isAdmin() && monthIsEditable(resource.data.yearMonth);
    }

    match /leaveRecords/{documentId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && validLeaveRecord(request.resource.data)
        && versionStartsAtOne(request.resource.data)
        && validCreateMetadata(request.resource.data)
        && monthIsEditable(request.resource.data.yearMonth);
      allow update: if isAdmin()
        && validLeaveRecord(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && versionIncrementsByOne(request.resource.data)
        && validUpdateMetadata(request.resource.data)
        && monthIsEditable(request.resource.data.yearMonth);
      allow delete: if isAdmin() && monthIsEditable(resource.data.yearMonth);
    }

    match /workdaySettings/{settingId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && settingId == 'main'
        && validWorkdaySettings(request.resource.data);
      allow delete: if false;
    }

    match /dailyPerformanceEntries/{documentId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && validDailyPerformance(request.resource.data)
        && versionStartsAtOne(request.resource.data)
        && validCreateMetadata(request.resource.data)
        && monthlyEntryIsEditable(request.resource.data.yearMonth);
      allow update: if isAdmin()
        && validDailyPerformance(request.resource.data)
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.date == resource.data.date
        && versionIncrementsByOne(request.resource.data)
        && validUpdateMetadata(request.resource.data)
        && monthlyEntryIsEditable(request.resource.data.yearMonth);
      allow delete: if isAdmin() && monthlyEntryIsEditable(resource.data.yearMonth);
    }

    match /monthlyPerformanceOverrides/{documentId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && validMonthlyOverride(request.resource.data)
        && versionStartsAtOne(request.resource.data)
        && validCreateMetadata(request.resource.data)
        && monthlyEntryIsEditable(request.resource.data.yearMonth);
      allow update: if isAdmin()
        && validMonthlyOverride(request.resource.data)
        && request.resource.data.employeeId == resource.data.employeeId
        && request.resource.data.yearMonth == resource.data.yearMonth
        && versionIncrementsByOne(request.resource.data)
        && validUpdateMetadata(request.resource.data)
        && monthlyEntryIsEditable(request.resource.data.yearMonth);
      allow delete: if isAdmin() && monthlyEntryIsEditable(resource.data.yearMonth);
    }

    match /monthlyPerformanceStatus/{documentId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && validMonthlyStatus(request.resource.data)
        && versionStartsAtOne(request.resource.data)
        && validCreateMetadata(request.resource.data)
        && monthIsEditable(request.resource.data.yearMonth);
      allow update: if isAdmin()
        && validMonthlyStatus(request.resource.data)
        && request.resource.data.yearMonth == resource.data.yearMonth
        && versionIncrementsByOne(request.resource.data)
        && validUpdateMetadata(request.resource.data)
        && monthIsEditable(request.resource.data.yearMonth);
      allow delete: if false;
    }

    match /monthClosures/{documentId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && validMonthClosure(request.resource.data)
        && versionStartsAtOne(request.resource.data)
        && validCreateMetadata(request.resource.data)
        && request.resource.data.status == 'FINALIZED'
        && exists(monthlyStatusPath(request.resource.data.yearMonth))
        && get(monthlyStatusPath(request.resource.data.yearMonth)).data.status == 'CLOSED';
      allow update: if isAdmin()
        && validMonthClosure(request.resource.data)
        && request.resource.data.yearMonth == resource.data.yearMonth
        && versionIncrementsByOne(request.resource.data)
        && validUpdateMetadata(request.resource.data)
        && ((request.resource.data.status == 'REOPENED' && resource.data.status == 'FINALIZED')
          || (request.resource.data.status == 'FINALIZED'
            && resource.data.status == 'REOPENED'
            && exists(monthlyStatusPath(request.resource.data.yearMonth))
            && get(monthlyStatusPath(request.resource.data.yearMonth)).data.status == 'CLOSED'));
      allow delete: if false;
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if hasActiveProfile() && validAuditLog(request.resource.data);
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
